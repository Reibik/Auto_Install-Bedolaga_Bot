#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

resolve_library_root() {
  local source_path="${BASH_SOURCE[0]}"
  while [[ -L "$source_path" ]]; do
    local source_dir
    source_dir="$(cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)"
    source_path="$(readlink "$source_path")"
    [[ "$source_path" == /* ]] || source_path="$source_dir/$source_path"
  done
  cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd
}

BEDOLAGA_LIB_ROOT="$(resolve_library_root)"
export BEDOLAGA_LIB_ROOT

# shellcheck source=lib/common.sh
source "$BEDOLAGA_LIB_ROOT/lib/common.sh"
# shellcheck source=lib/ui.sh
source "$BEDOLAGA_LIB_ROOT/lib/ui.sh"
# shellcheck source=lib/env.sh
source "$BEDOLAGA_LIB_ROOT/lib/env.sh"
# shellcheck source=lib/system.sh
source "$BEDOLAGA_LIB_ROOT/lib/system.sh"
# shellcheck source=lib/config.sh
source "$BEDOLAGA_LIB_ROOT/lib/config.sh"
# shellcheck source=lib/compose.sh
source "$BEDOLAGA_LIB_ROOT/lib/compose.sh"
# shellcheck source=lib/backup.sh
source "$BEDOLAGA_LIB_ROOT/lib/backup.sh"
# shellcheck source=lib/update.sh
source "$BEDOLAGA_LIB_ROOT/lib/update.sh"
# shellcheck source=lib/doctor.sh
source "$BEDOLAGA_LIB_ROOT/lib/doctor.sh"
# shellcheck source=lib/security.sh
source "$BEDOLAGA_LIB_ROOT/lib/security.sh"
# shellcheck source=lib/install.sh
source "$BEDOLAGA_LIB_ROOT/lib/install.sh"

trap 'on_error "$LINENO"' ERR

usage() {
  ui_banner 'Справка по командам'
  ui_section 'Основные команды'
  cat <<'EOF'
Использование:
  bedolaga install                  Первичная установка / повторный мастер
  bedolaga menu                     Интерактивное меню
  bedolaga status                   Статус и версии контейнеров
  bedolaga start|stop|restart       Управление стеком
  bedolaga apply                    Применить .env/Caddy/branding
  bedolaga logs [service]           Логи bot/cabinet/caddy/postgres/redis
  bedolaga doctor                   Диагностика DNS, HTTPS, API и контейнеров
  bedolaga config [target]          bot, stack, caddy, wizard или paths
  bedolaga versions                 Сравнить текущие и доступные commit
  bedolaga update [component]       all, bot или cabinet
  bedolaga rollback                 Откат последнего обновления приложений
  bedolaga backup [--automatic]     Создать резервную копию
  bedolaga backup-list              Показать резервные копии
  bedolaga restore <archive>        Восстановить резервную копию
  bedolaga schedule <action>        enable, disable или status
  bedolaga firewall <action>        безопасная настройка UFW
  bedolaga self-update              Обновить Manager
  bedolaga uninstall [--purge-data] Удалить проект
  bedolaga version                  Версия Manager
EOF
  ui_section 'Совместимость терминала'
  cat <<'EOF'
  NO_COLOR=1 bedolaga               Отключить ANSI-цвета
  BEDOLAGA_EMOJI=0 bedolaga         Отключить эмодзи
  BEDOLAGA_EMOJI=1 bedolaga         Принудительно включить эмодзи
EOF
}

menu_summary() {
  local os_name='не определена' docker_version='не установлен'
  local service state healthy=0 problems=0
  if detect_os 2>/dev/null; then
    os_name="$OS_PRETTY"
  fi
  if command_exists docker; then
    docker_version="$(docker version --format '{{.Server.Version}}' 2>/dev/null || docker --version 2>/dev/null | awk '{print $3}' | tr -d ',' || printf 'недоступен')"
  fi
  ui_key_value server 'Сервер' "$os_name"
  ui_key_value docker 'Docker' "$docker_version"
  if [[ -f "$COMPOSE_FILE" && -f "$STACK_ENV" ]]; then
    ui_key_value package 'Bot' "$(git_short_commit "$BOT_SOURCE_DIR")"
    ui_key_value package 'Cabinet' "$(git_short_commit "$CABINET_SOURCE_DIR")"
    for service in postgres redis bot cabinet caddy; do
      state="$(service_state "$service" 2>/dev/null || true)"
      if [[ "$state" == running/healthy || "$state" == running/none ]]; then
        ((healthy += 1))
      else
        ((problems += 1))
      fi
    done
    if [[ "$healthy" -eq 5 ]]; then
      ui_key_value healthy 'Состояние' 'Все сервисы работают'
    elif [[ "$problems" -eq 5 ]]; then
      ui_key_value stopped 'Состояние' 'Стек остановлен'
    else
      ui_key_value warning 'Состояние' "Требуют внимания: $problems"
    fi
  else
    ui_key_value stopped 'Состояние' 'Проект ещё не установлен'
  fi
}

menu_choose_service() {
  local variable_name="$1"
  local _bedolaga_service_choice=''
  printf '\n'
  ui_menu_item 1 bot 'Bot'
  ui_menu_item 2 globe 'Cabinet'
  ui_menu_item 3 lock 'Caddy'
  ui_menu_item 4 package 'PostgreSQL'
  ui_menu_item 5 package 'Redis'
  ui_menu_item 0 package 'Все сервисы'
  read_tty _bedolaga_service_choice "${C_CYAN}Выберите сервис [0]: ${C_RESET}"
  case "$_bedolaga_service_choice" in
    1) printf -v "$variable_name" '%s' bot ;;
    2) printf -v "$variable_name" '%s' cabinet ;;
    3) printf -v "$variable_name" '%s' caddy ;;
    4) printf -v "$variable_name" '%s' postgres ;;
    5) printf -v "$variable_name" '%s' redis ;;
    '' | 0) printf -v "$variable_name" '%s' '' ;;
    *) warn "Неизвестный сервис."; return 1 ;;
  esac
}

menu() {
  require_root
  local choice='' service=''
  while true; do
    ui_clear
    ui_banner
    printf '\n'
    menu_summary
    ui_section 'Управление'
    ui_menu_item 1 status 'Статус сервисов'
    ui_menu_item 2 start 'Запустить стек'
    ui_menu_item 3 stop 'Остановить стек'
    ui_menu_item 4 restart 'Перезапустить сервис'
    ui_menu_item 5 update 'Проверить обновления'
    ui_menu_item 6 deploy 'Обновить проект'
    ui_section 'Обслуживание'
    ui_menu_item 7 doctor 'Диагностика'
    ui_menu_item 8 logs 'Просмотр логов'
    ui_menu_item 9 config 'Настройка проекта'
    ui_menu_item 10 backup 'Создать резервную копию'
    ui_menu_item 11 archives 'Управление резервными копиями'
    ui_menu_item 12 rollback 'Откатить обновление'
    ui_separator
    ui_menu_item 0 exit 'Выход'
    read_tty choice "\n${C_CYAN}Выберите действие › ${C_RESET}"
    case "$choice" in
      1) bash "$BEDOLAGA_LIB_ROOT/bedolaga" status || true ;;
      2) bash "$BEDOLAGA_LIB_ROOT/bedolaga" start || true ;;
      3) bash "$BEDOLAGA_LIB_ROOT/bedolaga" stop || true ;;
      4)
        service=''
        if menu_choose_service service; then
          if [[ -n "$service" ]]; then
            bash "$BEDOLAGA_LIB_ROOT/bedolaga" restart "$service" || true
          else
            bash "$BEDOLAGA_LIB_ROOT/bedolaga" restart || true
          fi
        fi
        ;;
      5) bash "$BEDOLAGA_LIB_ROOT/bedolaga" versions || true ;;
      6) bash "$BEDOLAGA_LIB_ROOT/bedolaga" update all || true ;;
      7) bash "$BEDOLAGA_LIB_ROOT/bedolaga" doctor || true ;;
      8)
        service=''
        if menu_choose_service service; then
          if [[ -n "$service" ]]; then
            bash "$BEDOLAGA_LIB_ROOT/bedolaga" logs "$service" || true
          else
            bash "$BEDOLAGA_LIB_ROOT/bedolaga" logs || true
          fi
        fi
        ;;
      9)
        if bash "$BEDOLAGA_LIB_ROOT/bedolaga" config wizard; then
          if confirm "Применить новую конфигурацию сейчас?"; then
            bash "$BEDOLAGA_LIB_ROOT/bedolaga" apply || true
          fi
        fi
        ;;
      10) bash "$BEDOLAGA_LIB_ROOT/bedolaga" backup || true ;;
      11) bash "$BEDOLAGA_LIB_ROOT/bedolaga" backup-list || true ;;
      12) bash "$BEDOLAGA_LIB_ROOT/bedolaga" rollback || true ;;
      0) return 0 ;;
      *) warn "Неизвестный пункт." ;;
    esac
    read_tty choice "\n${C_CYAN}Нажмите Enter для возврата в меню...${C_RESET}"
  done
}

main() {
  local command="${1:-menu}"
  [[ $# -eq 0 ]] || shift
  case "$command" in
    install) install_stack "$@" ;;
    menu) menu ;;
    status) stack_status ;;
    start) stack_start ;;
    stop) stack_stop ;;
    restart) stack_restart "$@" ;;
    apply) stack_apply ;;
    logs) stack_logs "$@" ;;
    doctor) doctor ;;
    config) config_edit "$@" ;;
    versions) stack_versions ;;
    update) update_components "$@" ;;
    rollback) rollback_last_update ;;
    backup)
      if [[ "${1:-}" == "--automatic" ]]; then
        backup_run automatic
      else
        backup_run manual
      fi
      ;;
    backup-list) backup_list ;;
    restore) backup_restore "$@" ;;
    schedule) backup_schedule "$@" ;;
    firewall) firewall_manage "$@" ;;
    self-update) self_update ;;
    uninstall) uninstall_stack "$@" ;;
    version | --version | -v) printf 'Bedolaga Manager %s\n' "$BEDOLAGA_VERSION" ;;
    help | --help | -h) usage ;;
    *) error "Неизвестная команда: $command"; usage; return 2 ;;
  esac
}

main "$@"
