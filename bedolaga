source "$BEDOLAGA_LIB_ROOT/lib/menu.sh"

trap 'on_error "$LINENO"' ERR

usage() {
  ui_banner 'Справка по командам'
  ui_section 'Основные команды'
  cat <<'EOF'
Использование:
  bedolaga install                  Первичная установка / повторный мастер
  bedolaga menu                     Интерактивное меню
  bedolaga status                   Статус и версии контейнеров
  bedolaga start|stop|restart       Управление стеком
  bedolaga apply                    Применить .env/Caddy/branding
  bedolaga logs [service]           Логи основного стека и Xray Monitoring
  bedolaga doctor                   Диагностика DNS, HTTPS, API и контейнеров
  bedolaga config [target]          bot, stack, caddy, wizard или paths
  bedolaga versions                 Сравнить текущие и доступные commit
  bedolaga update [component]       all, bot, cabinet или xray
  bedolaga xray [action]            Установка и управление Xray Monitoring
  bedolaga rollback                 Откат последнего обновления приложений
  bedolaga backup [--automatic]     Создать резервную копию
  bedolaga backup-list              Показать резервные копии
  bedolaga restore <archive>        Восстановить резервную копию
  bedolaga schedule <action>        enable, disable или status
  bedolaga firewall <action>        безопасная настройка UFW
  bedolaga self-update [vX.Y.Z]     Обновить Manager до стабильной версии
  bedolaga uninstall [--purge-data] Удалить проект
  bedolaga version                  Версия Manager
EOF
  ui_section 'Совместимость терминала'
  cat <<'EOF'
  NO_COLOR=1 bedolaga               Отключить ANSI-цвета
  BEDOLAGA_EMOJI=0 bedolaga         Отключить эмодзи
  BEDOLAGA_EMOJI=1 bedolaga         Принудительно включить эмодзи
  BEDOLAGA_AUTO_UPDATE=0 bedolaga   Не проверять Manager при запуске меню
EOF
}

menu_host_summary() {
  local os_name='не определена' docker_version='не установлен'
  if detect_os 2>/dev/null; then
    os_name="$OS_PRETTY"
  fi
  if command_exists docker; then
    docker_version="$(docker version --format '{{.Server.Version}}' 2>/dev/null || docker --version 2>/dev/null | awk '{print $3}' | tr -d ',' || printf 'недоступен')"
  fi
  ui_key_value server 'Сервер' "$os_name"
  ui_key_value docker 'Docker' "$docker_version"
}

menu_summary() {
  local service state healthy=0 stopped=0 pending=0 problems=0 total=0
  local -A states=()
  if [[ -f "$COMPOSE_FILE" && -f "$STACK_ENV" ]]; then
    while IFS= read -r service; do
      ((total += 1))
      state="$(service_state "$service" 2>/dev/null || true)"
      states["$service"]="$state"
      case "$state" in
        running/healthy | running/none) ((healthy += 1)) ;;
        exited/0 | created/*) ((stopped += 1)) ;;
        running/starting | restarting/* | paused/* | removing/*) ((pending += 1)) ;;
        *) ((problems += 1)) ;;
      esac
    done < <(managed_services)
    if [[ "$healthy" -eq "$total" ]]; then
      ui_key_value healthy 'Стек' 'Все сервисы работают'
    elif [[ "$stopped" -eq "$total" ]]; then
      ui_key_value stopped 'Стек' 'Остановлен / не запущен'
    elif [[ "$problems" -gt 0 ]]; then
      ui_key_value warning 'Стек' "Требуют внимания: $problems"
    else
      ui_key_value starting 'Стек' "Работают: $healthy/$total; ожидание: $pending; остановлены: $stopped"
    fi
    ui_service_row 'Bot' "${states[bot]:-unknown/unknown}"
    ui_service_row 'Cabinet' "${states[cabinet]:-unknown/unknown}"
    if xray_monitoring_enabled; then
      if [[ "${states[xray-checker]:-}" == running/healthy || "${states[xray-checker]:-}" == running/none ]] &&
        [[ "${states[xray-statuspage]:-}" == running/healthy || "${states[xray-statuspage]:-}" == running/none ]]; then
        ui_key_value healthy 'Xray' 'Включён · работает'
      else
        ui_key_value warning 'Xray' 'Включён · проверьте статус'
      fi
    else
      ui_key_value stopped 'Xray' 'Не включён'
    fi
  else
    ui_key_value stopped 'Стек' 'Проект ещё не установлен'
    ui_key_value stopped 'Xray' 'Не включён'
  fi
  ui_key_value backup 'Бэкап' "$(menu_last_backup)"
}

menu_choose_service() {
  local variable_name="$1"
  local _bedolaga_service_choice=''
  printf '\n'
  ui_menu_item 1 bot 'Bot'
  ui_menu_item 2 globe 'Cabinet'
  ui_menu_item 3 lock 'Caddy'
  ui_menu_item 4 package 'PostgreSQL'
  ui_menu_item 5 package 'Redis'
  if xray_monitoring_enabled; then
    ui_menu_item 6 status 'Xray Status Page'
    ui_menu_item 7 doctor 'Xray Checker'
  fi
  ui_menu_item 0 package 'Все сервисы'
  ui_menu_item b exit 'Отмена'
  read_tty _bedolaga_service_choice "${C_CYAN}Сервис [0 — все]: ${C_RESET}"
  case "$_bedolaga_service_choice" in
    1) printf -v "$variable_name" '%s' bot ;;
    2) printf -v "$variable_name" '%s' cabinet ;;
    3) printf -v "$variable_name" '%s' caddy ;;
    4) printf -v "$variable_name" '%s' postgres ;;
    5) printf -v "$variable_name" '%s' redis ;;
    6) xray_monitoring_enabled && printf -v "$variable_name" '%s' xray-statuspage || return 1 ;;
    7) xray_monitoring_enabled && printf -v "$variable_name" '%s' xray-checker || return 1 ;;
    '' | 0) printf -v "$variable_name" '%s' '' ;;
    b | B) return 1 ;;
    *) warn "Неизвестный сервис."; return 1 ;;
  esac
}

menu() {
  require_root
  local choice='' update_status=0
  if manager_auto_update; then
    :
  else
    update_status=$?
    if [[ "$update_status" -eq 10 ]]; then
      read_tty choice "\n${C_CYAN}Нажмите Enter, чтобы открыть обновлённый Manager...${C_RESET}"
      exec env BEDOLAGA_SKIP_UPDATE_CHECK=1 bash "$BEDOLAGA_LIB_ROOT/bedolaga" menu
    fi
    warn "Автообновление не завершено. Открываю меню текущей версии v${BEDOLAGA_VERSION}."
    read_tty choice "${C_CYAN}Нажмите Enter для продолжения...${C_RESET}"
  fi
  unset BEDOLAGA_SKIP_UPDATE_CHECK
  while true; do
    ui_clear
    menu_draw_main
    read_tty choice "\n${C_CYAN}Раздел [0 — выход]: ${C_RESET}"
    case "$choice" in
      1) menu_submenu services ;;
      2) menu_submenu updates ;;
      3) menu_submenu settings ;;
      4) menu_submenu backups ;;
      5) menu_submenu diagnostics ;;
      6) menu_command xray menu || true ;;
      0) return 0 ;;
      *) warn "Неизвестный раздел."; menu_pause ;;
    esac
  done
}

main() {
  local command="${1:-menu}"
  [[ $# -eq 0 ]] || shift
  case "$command" in
    install) install_stack "$@" ;;
    menu) menu ;;
    status) stack_status ;;
    start) stack_start ;;
    stop) stack_stop ;;
    restart) stack_restart "$@" ;;
    apply) stack_apply ;;
    logs) stack_logs "$@" ;;
    doctor) doctor ;;
    config) config_edit "$@" ;;
    versions) stack_versions ;;
    update)
      if [[ "${1:-}" == xray ]]; then
        xray_update
      elif [[ "${1:-all}" == all ]]; then
        update_components all
        if xray_monitoring_enabled; then
          xray_update
        fi
      else
        update_components "$@"
      fi
      ;;
    xray) xray_manage "$@" ;;
    rollback) rollback_last_update ;;
    backup)
      if [[ "${1:-}" == "--automatic" ]]; then
        backup_run automatic
      else
        backup_run manual
      fi
      ;;
    backup-list) backup_list ;;
    restore) backup_restore "$@" ;;
    schedule) backup_schedule "$@" ;;
    firewall) firewall_manage "$@" ;;
    self-update) self_update "$@" ;;
    uninstall) uninstall_stack "$@" ;;
    version | --version | -v) printf 'Bedolaga Manager %s\n' "$BEDOLAGA_VERSION" ;;
    help | --help | -h) usage ;;
    *) error "Неизвестная команда: $command"; usage; return 2 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
